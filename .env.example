# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# Optional API key. When set, requests must include x-api-key.
AUTH_API_KEY=

# Redis. RedisSaver needs a Redis Stack/Redis with Search support in production.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=agent:
# development defaults to memory; set redis to verify durable RedisSaver state
CHECKPOINT_BACKEND=memory
CHECKPOINT_TTL_SECONDS=86400
MESSAGE_TTL_SECONDS=604800

# Models
DEFAULT_MODEL_PROVIDER=openai-compatible
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# For OpenAI-compatible providers such as vLLM, DashScope compatible endpoint, etc.

OPENAI_COMPATIBLE_API_KEY=sk-...
OPENAI_COMPATIBLE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_COMPATIBLE_MODEL=doubao-seed-2-1-pro-260628
# Operator-approved models exposed in the chat model selector. `model` and
# `provider` values outside this list are rejected by the API.
MODEL_CATALOG=[{"id":"doubao-seed-2-1-pro","label":"\u8c46\u5305 Seed 2.1 Pro","provider":"openai-compatible","model":"doubao-seed-2-1-pro-260628"},{"id":"deepseek-v4-flash","label":"DeepSeek V4 Flash","provider":"openai-compatible","model":"deepseek-v4-flash-ga-260731"}]

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
MODEL_TIMEOUT_MS=120000
PLANNER_TIMEOUT_MS=20000
SKILL_PLAN_TIMEOUT_MS=30000
# When the model planner times out, use SKILL.md name/trigger matching.
SKILL_PLANNER_FALLBACK_ENABLED=true
# When a Skill tool planner times out, derive calls only from explicit paths/URLs.
SKILL_TOOL_PLAN_FALLBACK_ENABLED=true
MODEL_MAX_RETRIES=1

# Agent safety
AGENT_RECURSION_LIMIT=25
AGENT_TIMEOUT_MS=180000
HISTORY_WINDOW_MESSAGES=16
# Older messages are compacted into a durable summary; raw messages remain stored.
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TRIGGER_MESSAGES=8
MEMORY_SUMMARY_MAX_CHARS=6000
MEMORY_SUMMARY_TIMEOUT_MS=20000

# Tool safety
SANDBOX_ROOT=./sandbox
MAX_FILE_READ_BYTES=262144
HTTP_TOOL_TIMEOUT_MS=15000
HTTP_TOOL_MAX_RESPONSE_BYTES=524288
# Comma-separated hostnames or *. Example: api.github.com,example.com
HTTP_TOOL_ALLOWED_HOSTS=*

# Skills
SKILLS_DIR=./skills
