# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# Optional API key. When set, requests must include x-api-key.
AUTH_API_KEY=

# Redis. RedisSaver needs a Redis Stack/Redis with Search support in production.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=agent:
# development defaults to memory; set redis to verify durable RedisSaver state
CHECKPOINT_BACKEND=memory
CHECKPOINT_TTL_SECONDS=86400
MESSAGE_TTL_SECONDS=604800

# Models
DEFAULT_MODEL_PROVIDER=openai-compatible
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Only supported with DEFAULT_MODEL_PROVIDER=openai. This keeps project-owned
# Redis history and additionally stores final responses at OpenAI; the next
# turn uses the stored response id through `previous_response_id`.
OPENAI_RESPONSES_STATE_ENABLED=false
OPENAI_RESPONSES_STORE=false
# For OpenAI-compatible providers such as vLLM, DashScope compatible endpoint, etc.

OPENAI_COMPATIBLE_API_KEY=sk-...
OPENAI_COMPATIBLE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_COMPATIBLE_MODEL=doubao-seed-2-1-pro-260628
# Enable only when the compatible endpoint supports /responses. Volcengine Ark
# supports this for approved Doubao models, including doubao-seed-2-1-pro-260628.
OPENAI_COMPATIBLE_RESPONSES_STATE_ENABLED=false
OPENAI_COMPATIBLE_RESPONSES_STORE=false
# Operator-approved models exposed in the chat model selector. `model` and
# `provider` values outside this list are rejected by the API. This catalog
# includes the Volcengine Ark models that support the Responses API.
MODEL_CATALOG=[{"id":"doubao-seed-evolving","label":"Doubao Seed Evolving","provider":"openai-compatible","model":"doubao-seed-evolving"},{"id":"doubao-seed-2-1-pro","label":"Doubao Seed 2.1 Pro","provider":"openai-compatible","model":"doubao-seed-2-1-pro-260628"},{"id":"doubao-seed-2-1-turbo","label":"Doubao Seed 2.1 Turbo","provider":"openai-compatible","model":"doubao-seed-2-1-turbo-260628"},{"id":"doubao-seed-2-0-lite-260428","label":"Doubao Seed 2.0 Lite","provider":"openai-compatible","model":"doubao-seed-2-0-lite-260428"},{"id":"doubao-seed-2-0-mini-260428","label":"Doubao Seed 2.0 Mini","provider":"openai-compatible","model":"doubao-seed-2-0-mini-260428"},{"id":"doubao-seed-2-0-pro","label":"Doubao Seed 2.0 Pro","provider":"openai-compatible","model":"doubao-seed-2-0-pro-260215"},{"id":"doubao-seed-2-0-lite-260215","label":"Doubao Seed 2.0 Lite 260215","provider":"openai-compatible","model":"doubao-seed-2-0-lite-260215"},{"id":"doubao-seed-2-0-mini-260215","label":"Doubao Seed 2.0 Mini 260215","provider":"openai-compatible","model":"doubao-seed-2-0-mini-260215"},{"id":"doubao-seed-2-0-code-preview","label":"Doubao Seed 2.0 Code Preview","provider":"openai-compatible","model":"doubao-seed-2-0-code-preview-260215"},{"id":"doubao-seed-1-8","label":"Doubao Seed 1.8","provider":"openai-compatible","model":"doubao-seed-1-8-251228"},{"id":"doubao-seed-character","label":"Doubao Seed Character","provider":"openai-compatible","model":"doubao-seed-character-260628"}]
# To test Responses API state, replace the active provider and catalog values
# above with this complete OpenAI configuration:
# DEFAULT_MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_RESPONSES_STATE_ENABLED=true
# OPENAI_RESPONSES_STORE=true
# MODEL_CATALOG=[{"id":"gpt-4-1-mini","label":"GPT-4.1 mini (Responses)","provider":"openai","model":"gpt-4.1-mini"}]
# For Volcengine Ark Responses API, keep provider=openai-compatible and set:
# OPENAI_COMPATIBLE_RESPONSES_STATE_ENABLED=true
# OPENAI_COMPATIBLE_RESPONSES_STORE=true

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
MODEL_TIMEOUT_MS=120000
PLANNER_TIMEOUT_MS=20000
SKILL_PLAN_TIMEOUT_MS=30000
# When the model planner times out, use SKILL.md name/trigger matching.
SKILL_PLANNER_FALLBACK_ENABLED=true
# When a Skill tool planner times out, derive calls only from explicit paths/URLs.
SKILL_TOOL_PLAN_FALLBACK_ENABLED=true
MODEL_MAX_RETRIES=1

# Agent safety
AGENT_RECURSION_LIMIT=25
AGENT_TIMEOUT_MS=180000
HISTORY_WINDOW_MESSAGES=16
# Older messages are compacted into a durable summary; raw messages remain stored.
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TRIGGER_MESSAGES=8
MEMORY_SUMMARY_MAX_CHARS=6000
MEMORY_SUMMARY_TIMEOUT_MS=20000

# Tool safety
SANDBOX_ROOT=./sandbox
MAX_FILE_READ_BYTES=262144
HTTP_TOOL_TIMEOUT_MS=15000
HTTP_TOOL_MAX_RESPONSE_BYTES=524288
# Comma-separated hostnames or *. Example: api.github.com,example.com
HTTP_TOOL_ALLOWED_HOSTS=*

# Skills
SKILLS_DIR=./skills
